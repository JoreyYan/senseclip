# ===== SenseClip 环境变量示例(复制为 .env 后填写)=====

# --- Supabase(必填)---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=                      # service_role key,仅服务端使用,切勿暴露到前端
SUPABASE_ANON_KEY=                 # anon key
ADMIN_KEY=                         # 管理端点鉴权(自定义随机字符串)
ENABLE_ADMIN_SQL=false             # /api/admin/apply-sql 开关(服务端跑任意 SQL,仅自有实例排障时临时打开)

# --- 模型提供商 ---
DEEPSEEK_API_KEY=                  # 主力问答/处理模型(可选)
CLAUDE_API_KEY=                    # 兜底 + 敏感内容处理(可选,但强烈建议)
SILICONFLOW_API_KEY=               # 向量 bge-m3 + 图片理解(可选;缺省回退 OpenAI)
OPENAI_API_KEY=                    # 向量回退(可选)
GROQ_API_KEY=                      # Whisper 转录(必填,若要处理视频)
TAVILY_API_KEY=                    # 联网搜索(可选)
TWITTERAPI_KEY=                    # X 推文抓取 twitterapi.io(可选)

# --- 服务角色 ---
SERVICE_MODE=api                   # api = 产品服务 / engine = 处理引擎(跑 worker)
ENGINE_URL=                        # api 模式下转发引擎控制请求的地址(可选)

# --- 处理引擎参数 ---
BACKFILL_CONCURRENCY=3
BACKFILL_RESCAN_MINUTES=20
BACKFILL_MAX_SECONDS=5400          # 超过此时长的视频跳过;0 = 不限制

# --- 计费(可选模块)---
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SIGNUP_BONUS_CREDITS=30

# --- 前端(apps/web,Vite)---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000
